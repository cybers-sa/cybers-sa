{
  "name": "cybers-sa",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cybers-events",
      "database_id": "ضع-هنا-Database-ID"
    }
  ]
}
